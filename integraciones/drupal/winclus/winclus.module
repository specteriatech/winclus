<?php

/**
 * @file
 * Winclus: carga el widget de accesibilidad en todas las páginas.
 *
 * Para cambiar posición, cámara o idioma, edita los atributos data-* en
 * winclus.libraries.yml (o en un tema, con hook_library_info_alter).
 */

/**
 * Implements hook_page_attachments().
 */
function winclus_page_attachments(array &$attachments) {
  $attachments['#attached']['library'][] = 'winclus/widget';
}

/**
 * Implements hook_help().
 */
function winclus_help($route_name, $route_match) {
  if ($route_name === 'help.page.winclus') {
    return '<p>' . t('Winclus añade tecnología de apoyo al sitio (cara, voz, pulsador, teclado en pantalla, pictogramas, lectura y color). No sustituye la accesibilidad del propio sitio. Declaración y política de datos en https://winclus.com/accesibilidad y https://winclus.com/privacidad.') . '</p>';
  }
}
